<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net47 - Revit 2020, он же подходит Revit 2021-2024 (net48) -->
        <TargetFrameworks>net47;net8.0</TargetFrameworks>
        <RootNamespace>Alexpivo394.Revit.Clash.Geometry</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackageId>Alexpivo394.Revit.Clash.Geometry</PackageId>
        <Description>Clash detection geometry format: tessellated element meshes in millimetres, binary read and write.</Description>
        <PackageTags>revit;autodesk;clash;geometry</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Alexpivo394.Revit.Clash.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Polyfill" PrivateAssets="all"/>
        <PackageReference Include="System.IO.Hashing"/>
        <PackageReference Include="System.Numerics.Vectors" Condition="'$(TargetFramework)' == 'net47'"/>
    </ItemGroup>

</Project>
