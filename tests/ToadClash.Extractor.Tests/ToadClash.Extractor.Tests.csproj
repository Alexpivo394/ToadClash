<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ExtractorApiYear Condition="'$(ExtractorApiYear)' == ''">2022</ExtractorApiYear>
    <DefineConstants Condition="$(ExtractorApiYear) == '2021'">$(DefineConstants);REVIT2021_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$(ExtractorApiYear) == '2022'">$(DefineConstants);REVIT2022_OR_GREATER;REVIT2021_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit"/>
    <PackageReference Include="Shouldly"/>
    <ProjectReference Include="../../source/Alexpivo394.Revit.Clash.Geometry/Alexpivo394.Revit.Clash.Geometry.csproj"/>
    <Compile Include="../../source/Alexpivo394.Revit.Clash.Revit/ParameterReader.cs" Link="Production/ParameterReader.cs"/>
    <Compile Include="../../source/Alexpivo394.Revit.Clash.Revit/GeometryExtractor.cs" Link="Production/GeometryExtractor.cs"/>
    <Compile Include="../../source/Alexpivo394.Revit.Clash.Revit/MeshBuilder.cs" Link="Production/MeshBuilder.cs"/>
    <Compile Include="../../source/Alexpivo394.Revit.Clash.Revit/ExtractOptions.cs" Link="Production/ExtractOptions.cs"/>
    <Compile Include="../../source/Alexpivo394.Revit.Clash.Revit/ExtractResult.cs" Link="Production/ExtractResult.cs"/>
    <Compile Include="../../source/Alexpivo394.Revit.Clash.Revit/ElementGuard.cs" Link="Production/ElementGuard.cs"/>
    <Compile Include="../../source/Alexpivo394.Revit.Clash.Revit/ExtractProgress.cs" Link="Production/ExtractProgress.cs"/>
    <Compile Include="../../source/Alexpivo394.Revit.Clash.Revit/ProgressThrottle.cs" Link="Production/ProgressThrottle.cs"/>
  </ItemGroup>
</Project>
